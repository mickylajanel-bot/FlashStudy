rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isVerified() {
      // Mandating email verification for writes as per standard security guidelines
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile Validation ---
    function isValidUser(data) {
      return (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 100))
        && (!('email' in data) || (data.email is string && data.email.size() <= 255))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('lastLogin' in data) || (data.lastLogin is string))
        && (!('activity' in data) || (data.activity is list && data.activity.size() <= 1000))
        && (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 50))
        && (!('avatarImage' in data) || (data.avatarImage is string && data.avatarImage.size() <= 1000))
        && (!('updatedAt' in data) || (data.updatedAt is string));
    }

    // --- Deck Validation ---
    function isValidDeck(data) {
      return (!('id' in data) || (data.id is string && isValidId(data.id)))
        && (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 200))
        && (!('cards' in data) || (data.cards is list && data.cards.size() <= 500))
        && (!('creatorId' in data) || (data.creatorId is string))
        && (!('createdAt' in data) || (data.createdAt is number))
        && (!('updatedAt' in data) || (data.updatedAt is number))
        && (!('progress' in data) || (data.progress is number && data.progress >= 0 && data.progress <= 1))
        && (!('lastStudied' in data) || (data.lastStudied is number));
    }

    // --- Collection Matches ---
    
    match /users/{userId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      
      allow create: if isSignedIn() && isOwner(userId)
        && incoming().keys().hasAll(['name', 'email', 'updatedAt'])
        && isValidUser(incoming());
        
      allow update: if isSignedIn() && isOwner(userId)
        && isValidUser(incoming())
        && (
          // Allow updates to mutable fields
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'bio', 'avatarColor', 'avatarImage', 'lastLogin', 'activity', 'updatedAt'])
        );
        
      allow delete: if false; 

      match /decks/{deckId} {
        allow get, list: if isSignedIn() && isOwner(userId);
        
        allow create: if isSignedIn() && isOwner(userId)
          && incoming().keys().hasAll(['id', 'name', 'cards', 'createdAt', 'creatorId', 'updatedAt'])
          && isValidDeck(incoming());
          
        allow update: if isSignedIn() && isOwner(userId)
          && isValidDeck(incoming())
          && (
            // Allow updates to mutable fields (setDoc often sends everything)
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'cards', 'progress', 'lastStudied', 'updatedAt', 'id', 'creatorId', 'createdAt'])
            && (!('id' in incoming()) || (incoming().id == existing().id))
            && (!('creatorId' in incoming()) || (incoming().creatorId == existing().creatorId))
            && (!('createdAt' in incoming()) || (incoming().createdAt == existing().createdAt))
          );
          
        allow delete: if isSignedIn() && isOwner(userId);
      }
    }
  }
}
